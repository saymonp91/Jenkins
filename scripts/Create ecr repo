#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# create-ecr-repo.sh
# Cria o repositório no Amazon ECR (execute apenas uma vez).
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

AWS_REGION="${AWS_REGION:-us-east-1}"
REPO_NAME="${REPO_NAME:-minha-app}"

echo "🏗️  Criando repositório ECR: ${REPO_NAME}..."

aws ecr create-repository \
    --repository-name "$REPO_NAME" \
    --region "$AWS_REGION" \
    --image-scanning-configuration scanOnPush=true \
    --image-tag-mutability MUTABLE \
    2>/dev/null || echo "ℹ️  Repositório já existe."

# Política de lifecycle: mantém apenas as últimas 20 imagens
aws ecr put-lifecycle-policy \
    --repository-name "$REPO_NAME" \
    --region "$AWS_REGION" \
    --lifecycle-policy-text '{
        "rules": [{
            "rulePriority": 1,
            "description": "Manter apenas as 20 imagens mais recentes",
            "selection": {
                "tagStatus": "any",
                "countType": "imageCountMoreThan",
                "countNumber": 20
            },
            "action": { "type": "expire" }
        }]
    }'

echo "✅ Repositório ECR pronto!"
ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
echo "📌 URI: ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${REPO_NAME}"